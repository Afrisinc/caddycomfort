# Copy to .env next to docker-compose.yml.
#
# This file does double duty: compose reads it for ${...} interpolation, and
# it is passed into the containers via `env_file:`. Keep it to plain KEY=VALUE
# lines with no inline comments after a value.

# --- Images ---------------------------------------------------------------
# The deploy workflow exports these over SSH, so they do not need to be set
# here. Set them only if you run docker compose by hand on the box.
# GHCR_OWNER=afrisinc
# IMAGE_TAG=main

# --- Public exposure ------------------------------------------------------
# Public origin of the site. Baked into the frontend build at image build time.
PUBLIC_APP_URL=https://caddycomfort.example.com
# Host port the frontend is published on, always bound to 127.0.0.1 so the
# host reverse proxy fronts it. Must not collide with another service on the
# VPS (homextech already holds 5000).
FRONTEND_PORT=5001

# --- Server ---------------------------------------------------------------
# Browser calls are same-origin via the /api rewrite, so this only needs the
# public site origin. Use * only if you deliberately want an open API.
CORS_ORIGIN=https://caddycomfort.example.com

# --- Database -------------------------------------------------------------
# Supabase: you MUST use the pooler host, not db.<ref>.supabase.co.
# The direct host is IPv6-only and docker containers have no IPv6 by default,
# so it fails with "P1001: Can't reach database server". The pooler has IPv4.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Note the username is postgres.<ref>, not plain postgres. Port 5432 on the
# pooler is session mode, which prisma migrate needs; 6543 is transaction mode
# and would additionally require ?pgbouncer=true.
# If the region is wrong the pooler answers "(ENOTFOUND) tenant/user not found".
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Uploads --------------------------------------------------------------
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# --- Cloudinary -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (optional) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
