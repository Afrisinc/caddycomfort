# Copy to .env next to docker-compose.yml. Compose reads this file only for
# interpolation — the values land in the backend container via `environment:`.

# --- Images ---------------------------------------------------------------
# The deploy workflow exports these over SSH, so they do not need to be set in
# the VPS .env. Set GHCR_OWNER here only if you run `docker compose pull`
# by hand on the box.
# GHCR_OWNER=afrisinc
# IMAGE_TAG=production

# --- Public exposure ------------------------------------------------------
# Public origin of the site. Baked into the frontend build and used as the
# backend's CORS origin.
PUBLIC_APP_URL=https://shop.example.com
# Host port the frontend is published on.
FRONTEND_PORT=3000
# 127.0.0.1 keeps it behind a reverse proxy (recommended).
# Use 0.0.0.0 to publish it straight to the internet.
FRONTEND_BIND=127.0.0.1

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Uploads --------------------------------------------------------------
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# --- Cloudinary -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (optional) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
